# Cole os valores do app Web (Firebase Console → Configurações do projeto).
# Sem estas três primeiras, o jogo abre no save local e não fala com o Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# App Check (reCAPTCHA v3). Vazio = não pede token. No emulador deixe vazio.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# 1 = Auth/Firestore/Functions nos emuladores locais (127.0.0.1). App Check fica desligado.
VITE_FIREBASE_EMULATORS=
